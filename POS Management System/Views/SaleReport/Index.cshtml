@model IEnumerable<POS_Management_System.Models.StockOut>


@{
    ViewData["Title"] = "Sale Report";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Reports</p>
                    <h1 class="h3 mb-1">
                        Sales Report
                    </h1>
                    <p class="text-muted mb-0">
                        View sales between selected dates.
                    </p>
                </div>
            </div>
            <div>
                <a href="#" class="btn btn-success">
                    <i class="bi bi-download"></i>
                    Download
                </a>
            </div>
        </div>
        <section class="panel mt-4">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-funnel"></i>
                        Filter Report
                    </h2>
                </div>
            </div>
            <div class="p-3">
                <form method="post" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">
                                From Date
                            </label>
                            <input type="date"
                                   name="fromDate"
                                   value="@ViewBag.FromDate"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                To Date
                            </label>
                            <input type="date"
                                   name="toDate"
                                   value="@ViewBag.ToDate"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end gap-2">
                            <button class="btn btn-primary">
                                <i class="bi bi-search"></i>
                                Filter
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Reset

                            </a>

                        </div>

                    </div>

                </form>

            </div>

        </section>
        <section class="panel mt-4">

            <div class="panel-header">

                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-table"></i>
                        Sales Report
                    </h2>

                    <p class="text-muted mb-0">
                        View all sales.
                    </p>
                </div>

                <input class="form-control form-control-sm table-search"
                       type="search"
                       placeholder="Search..."
                       data-table-search="salesTable" />

            </div>

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       id="salesTable"
                       data-searchable-table>

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Remaining</th>
                            <th>Payment</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int i = 1;
                        }

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        @(item.Customer?.Name ?? "Walk In Customer")
                                    </td>
                                    <td>
                                        @item.Date.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        Rs. @item.CustomerPayment?.TotalAmount.ToString("N2")
                                    </td>
                                    <td>
                                        Rs. @item.CustomerPayment?.PaidAmount.ToString("N2")
                                    </td>
                                    <td>
                                        Rs. @item.CustomerPayment?.RemainingAmount.ToString("N2")
                                    </td>
                                    <td>
                                        <span class="badge bg-success">
                                            @item.CustomerPayment?.PaymentMethod
                                        </span>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="mt-3 mb-0">
                                        No sales found.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Any())
                    {
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">
                                    Grand Total
                                </th>
                                <th>
                                    Rs. @Model.Sum(x => x.CustomerPayment.TotalAmount).ToString("N2")
                                </th>
                                <th>
                                    Rs. @Model.Sum(x => x.CustomerPayment.PaidAmount).ToString("N2")
                                </th>
                                <th>
                                    Rs. @Model.Sum(x => x.CustomerPayment.RemainingAmount).ToString("N2")
                                </th>
                                <th></th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </section>
    </div>
</main>