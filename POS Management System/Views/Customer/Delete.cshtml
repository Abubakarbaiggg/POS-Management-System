@model POS_Management_System.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-person-x"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Danger Zone</p>
                    <h1 class="h3 mb-1">Delete Customer</h1>
                    <p class="text-muted mb-0">Permanently remove customer record from system.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Warning</span>
                    </h2>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
            </div>

            <div class="p-3">

                <div class="alert alert-warning">
                    <h5 class="mb-1">⚠️ Are you sure you want to delete this customer?</h5>
                    <p class="mb-0">Once deleted, this data cannot be recovered.</p>
                </div>

                <dl class="row mt-3">

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@(Model.Email ?? "N/A")</dd>

                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">@(Model.Address ?? "N/A")</dd>

                </dl>

                <form asp-action="Delete">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-danger">
                            Delete Customer
                        </button>

                    </div>

                </form>

            </div>

        </section>

    </div>
</main>