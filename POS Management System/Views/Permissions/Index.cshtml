@* @model POS_Management_System.Helpers.PaginatedList<POS_Management_System.Models.Permission> *@
@model List<POS_Management_System.Models.ViewModels.PermissionGroupViewModel>

@{
    ViewData["Title"] = "Permissions";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Permissions</h1>
                    <p class="text-muted mb-0">
                        Manage system permissions and access controls.
                    </p>
                </div>
            </div>

            <div>
                <a asp-action="Create" class="btn btn-primary">
                    Create Permission
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">

                <div id="successToast"
                     class="toast align-items-center text-bg-success border-0 shadow-lg"
                     role="alert">

                    <div class="d-flex">

                        <div class="toast-body d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>@TempData["Success"]</span>
                        </div>

                        <button type="button"
                                class="btn-close btn-close-white me-2 m-auto"
                                data-bs-dismiss="toast"></button>

                    </div>
                </div>

            </div>
        }

        <section class="panel mt-4">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-shield-lock"></i>
                        <span>Permissions List</span>
                    </h2>

                    <p class="text-muted mb-0">
                        View and manage application permissions.
                    </p>
                </div>

                <input class="form-control form-control-sm table-search" type="search"
                    placeholder="Search Permissions" data-table-search="permissionsTable" />
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0" id="permissionsTable" data-searchable-table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Permission Name</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }

                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td class="fw-semibold">
                                    @permission.Name
                                </td>
                                <td>
                                    @foreach (var item in permission.Permissions)
                                    {
                                        <form asp-action="Delete" method="post" style="display:inline;">
                                            <input type="hidden" name="name" value="@permission.Name" />
                                            <input type="hidden" name="type" value="@item.Type" />

                                            <span class="badge bg-primary me-1 d-inline-flex align-items-center gap-1">
                                                @item.Type

                                                <button type="submit"
                                                        style="border:none;background:none;color:white;font-weight:bold;">
                                                    ×
                                                </button>
                                            </span>
                                        </form>
                                    }
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
                @* <partial name="_Pagination" model="Model" /> *@

            </div>
        </section>

    </div>
</main>