@model POS_Management_System.Models.Permission

@{
    ViewData["Title"] = "Edit Permission";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- PAGE HEADER -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Edit Permission</h1>
                    <p class="text-muted mb-0">
                        Update existing system permission details.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM -->
            <div class="col-12 col-xl-8">

                <form asp-action="Edit" method="post" class="panel needs-validation">

                    <!-- Hidden ID -->
                    <input type="hidden" asp-for="Id" />

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-pencil-square"></i>
                                <span>Edit Permission</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Modify permission name carefully.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <!-- Permission Name -->
                        <div class="col-12">
                            <label asp-for="Name" class="form-label"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter permission name" />

                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>

                    </div>

                </form>

            </div>

            <!-- SIDE PANEL -->
            <div class="col-12 col-xl-4">

                <div class="panel h-100">

                    <h2 class="h5 mb-3 section-title">
                        <i class="bi bi-info-circle"></i>
                        <span>Important Notes</span>
                    </h2>

                    <div class="activity-list">

                        <div class="activity-item">
                            <span class="activity-dot bg-warning"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Be Careful</p>
                                <p class="text-muted small mb-0">
                                    Changing permissions may affect user access.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-primary"></span>
                            <div>
                                <p class="mb-1 fw-semibold">System Impact</p>
                                <p class="text-muted small mb-0">
                                    Updates apply instantly to all assigned roles.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-success"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Best Practice</p>
                                <p class="text-muted small mb-0">
                                    Keep permission names clear and consistent.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}