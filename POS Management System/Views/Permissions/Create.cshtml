@model POS_Management_System.Models.Permission

@{
    ViewData["Title"] = "Create Permission";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- PAGE HEADER -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Create Permission</h1>
                    <p class="text-muted mb-0">
                        Add a new system permission for role-based access control.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM SECTION -->
            <div class="col-12 col-xl-8">

                <form asp-action="Create" method="post" class="panel needs-validation">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-shield-plus"></i>
                                <span>Permission Details</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Define permission name for system access control.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter Permission" />

                        </div>
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label"></label>

                            <select asp-for="Type" class="form-select">
                                <option value="">-- Select Type --</option>
                                <option>Create</option>
                                <option>Edit</option>
                                <option>Delete</option>
                                <option>View</option>
                            </select>

                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Permission
                        </button>

                    </div>

                </form>

            </div>

            <!-- SIDE PANEL -->
            <div class="col-12 col-xl-4">

                <div class="panel h-100">

                    <h2 class="h5 mb-3 section-title">
                        <i class="bi bi-info-circle"></i>
                        <span>Guidelines</span>
                    </h2>

                    <div class="activity-list">

                        <div class="activity-item">
                            <span class="activity-dot bg-success"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Unique Name</p>
                                <p class="text-muted small mb-0">
                                    Permission names must be unique.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-primary"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Role Mapping</p>
                                <p class="text-muted small mb-0">
                                    Assign permissions to roles later.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-warning"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Security</p>
                                <p class="text-muted small mb-0">
                                    Permissions control system access.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
  
}