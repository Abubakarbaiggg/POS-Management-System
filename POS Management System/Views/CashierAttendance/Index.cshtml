@model POS_Management_System.Models.ViewModels.CashierAttendanceViewModal

@{
    ViewData["PageCategory"] = "Management";
    ViewData["PageTitle"] = "Cashier Management";
    ViewData["PageDescription"] = "Manage product categories and cashier attendance.";
    ViewData["PageIcon"] = "bi-tags";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <partial name="_PageHeader" />

            <div class="card shadow-sm px-3 py-2">
                <small class="text-muted">
                    <i class="bi bi-clock me-1"></i> Total Time
                </small>

                <h5 class="mb-0" id="totalTimer">00:00:00</h5>
            </div>
            <div class="card shadow-sm px-3 py-2">
                <small class="text-muted">
                    <i class="bi bi-clock-history me-1"></i> Active Time
                </small>

                <h5 class="mb-0" id="activeTimer">00:00:00</h5>
            </div>
            <div class="card shadow-sm px-3 py-2">
                <small class="text-muted">
                    <i class="bi bi-cup-hot me-1"></i> Break Time
                </small>

                <h5 class="mb-0" id="breakTimer">00:00:00</h5>
            </div>
            

            <div class="d-flex flex-wrap gap-2">
                <form asp-controller="CashierAttendance" asp-action="PunchIn" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                        Punch In
                    </button>
                </form>

                <form asp-controller="CashierAttendance" asp-action="PunchOut" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                        Punch Out
                    </button>
                </form>

                
                <form asp-controller="CashierAttendance" asp-action="Ready" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                        Ready
                    </button>
                </form>


                <form asp-controller="CashierAttendance" asp-action="AddBreak" method="post"
                      class="d-inline-flex align-items-center gap-2">

                    @Html.AntiForgeryToken()

                    <select name="breakType" class="form-select" required>
                        <option value="">Select Break</option>
                        @foreach (var item in Model.Breaks)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-clock me-1" aria-hidden="true"></i>
                        Add
                    </button>
                </form>

            </div>
        </div>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["Error"]</div>
        }

        <section class="panel">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Details</th>
                            <th>Comment</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                                <tr>
                                    <td class="fw-semibold">
                                        Please check stock. One piece was missing last night.
                                    </td>

                                    <td class="fw-semibold">
                                        Boss, the manager took this piece last time.
                                    </td>

                                    <td class="text-end">
                                        <form asp-controller="CashierAttendance" asp-action="UpdateStatus" method="post"
                                              class="d-inline-flex align-items-center gap-2">

                                            @Html.AntiForgeryToken()
                                            <div>
                                                 <a asp-action="CashierReply" class="btn btn-primary">
                                                    <i class="bi bi-plus-circle"></i> Reply
                                                </a>
                                            </div>
                                            <input type="hidden" name="id"  />

                                            <select name="status" class="form-select form-select-sm" required>
                                                <option value="">Select Status</option>
                                                <option value="Pending">Pending</option>
                                                <option value="InProgress">In Progress</option>
                                                <option value="Completed">Completed</option>
                                                <option value="OnHold">On Hold</option>
                                                <option value="Cancelled">Cancelled</option>
                                            </select>

                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Update
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <script>
                    const clockIn = @Html.Raw(
                                        System.Text.Json.JsonSerializer.Serialize(
                                                Model.Attendance?.ClockIn
                                        )
                                );

                    const clockOut = @Html.Raw(
                                        System.Text.Json.JsonSerializer.Serialize(
                                                Model.Attendance?.ClockOut
                                        )
                                );

                    const activeBreakStart = @Html.Raw(
                                        System.Text.Json.JsonSerializer.Serialize(
                                                Model.ActiveBreakStart
                                        )
                                );

                    const completedBreakSeconds = @Model.CompletedBreakSeconds;

                    function formatTime(seconds) {
                        seconds = Math.max(0, Math.floor(seconds));

                        const hours = Math.floor(seconds / 3600);
                        const minutes = Math.floor((seconds % 3600) / 60);
                        const secs = seconds % 60;

                        return [
                            String(hours).padStart(2, '0'),
                            String(minutes).padStart(2, '0'),
                            String(secs).padStart(2, '0')
                        ].join(':');
                    }

                    function updateTimers() {
                        const now = new Date();

                        if (!clockIn) {
                            return;
                        }

                        const start = new Date(clockIn);
                        const end = clockOut ? new Date(clockOut) : now;
                        const totalSeconds = (end - start) / 1000;
                        let breakSeconds = completedBreakSeconds;
                        
                        if (activeBreakStart) {
                            const breakStart = new Date(activeBreakStart);
                            const breakEnd = clockOut ? new Date(clockOut) : now;
                            breakSeconds += (breakEnd - breakStart) / 1000;
                        }

                        const activeSeconds = totalSeconds - breakSeconds;
                        document.getElementById("totalTimer").textContent = formatTime(totalSeconds);
                        document.getElementById("breakTimer").textContent = formatTime(breakSeconds);
                        document.getElementById("activeTimer").textContent =formatTime(activeSeconds);
                    }

                    updateTimers();

                    setInterval(updateTimers, 1000);
        </script>
    </div>
</main>
