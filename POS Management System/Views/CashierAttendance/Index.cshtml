@model IEnumerable<POS_Management_System.Models.Category>

@{
    ViewData["Title"] = "Categories";
    ViewData["PageTitle"] = "Categories";
    ViewData["PageDescription"] = "Manage product categories and cashier attendance.";
    ViewData["PageIcon"] = "bi-tags";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Categories</h1>
                    <p class="text-muted mb-0">
                        Manage product categories and cashier attendance.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <form asp-controller="CashierAttendance" asp-action="PunchIn" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                        Punch In
                    </button>
                </form>

                <form asp-controller="CashierAttendance" asp-action="PunchOut" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                        Punch Out
                    </button>
                </form>

                <form asp-controller="CashierAttendance" asp-action="AddBreak" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-cup-hot me-1" aria-hidden="true"></i>
                        Add Break
                    </button>
                </form>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                    Add Category
                </a>
            </div>
        </div>

        <section class="panel">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Id</td>
                                    <td class="fw-semibold">@category.Name</td>
                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn-warning btn-sm"
                                           aria-label="Edit @category.Name">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@category.Id"
                                           class="btn btn-danger btn-sm"
                                           aria-label="Delete @category.Name">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    No categories found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
