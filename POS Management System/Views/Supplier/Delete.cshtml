@model POS_Management_System.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Danger Zone</p>
                    <h1 class="h3 mb-1">Delete Supplier</h1>
                    <p class="text-muted mb-0">Permanently remove supplier record from system.</p>
                </div>
            </div>
        </div>

        <section class="row justify-content-center">

            <div class="col-12 col-xl-6">

                <div class="panel border-danger">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title text-danger">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span>Warning</span>
                            </h2>
                            <p class="text-muted mb-0">This action cannot be undone.</p>
                        </div>
                    </div>

                    <div class="p-3">

                        <div class="alert alert-danger">
                            <strong>Are you sure?</strong>
                            You are about to permanently delete this supplier.
                        </div>

                        <dl class="row mb-3">
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.Name</dd>

                            <dt class="col-sm-4">Phone</dt>
                            <dd class="col-sm-8">@Model.Phone</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@(Model.Email ?? "N/A")</dd>

                            <dt class="col-sm-4">Address</dt>
                            <dd class="col-sm-8">@(Model.Address ?? "N/A")</dd>
                        </dl>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>