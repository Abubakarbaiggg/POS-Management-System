@model IEnumerable<POS_Management_System.Models.WorkShifts>

@{
    ViewData["Title"] = "Cashier Shift Managment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageCategory"] = "Administration";
    ViewData["PageTitle"] = "Cashier Shift";
    ViewData["PageDescription"] = "Manage cashier shift date and timing";
    ViewData["PageIcon"] = "bi-people";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <partial name="_PageHeader" />

            <div class="heading-actions">
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-person-plus"></i> Create User
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <section class="panel">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ShiftName</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var shifts in Model)
                        {
                            <tr>
                                <td>@shifts.ShiftName</td>
                                <td>@shifts.StartDate</td>
                                <td>@shifts.EndDate</td>
                                <td>@shifts.StartTime</td>
                                <td>@shifts.EndTime</td>

                                <td>
                                    @if (shifts.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <form asp-action="ToggleShiftStatus" method="post"
                                              class="d-flex align-items-center gap-2 mb-0">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@shifts.Id" />

                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch" checked="@shifts.IsActive" onchange="this.form.submit()">
                                            </div>

                                            <small class="@(shifts.IsActive ? "text-success" : "text-danger")"> </small>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@shifts.Id" class="btn btn-sm btn-warning" title="Edit" aria-label="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@shifts.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
