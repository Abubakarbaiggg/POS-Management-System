@model POS_Management_System.Models.WorkShifts
@{
    ViewData["Title"] = "Create Cashier Shift";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageCategory"] = "Cashier Management";
    ViewData["PageTitle"] = "Create Cashier Shift";
    ViewData["PageDescription"] = "Assign a new shift to a cashier.";
    ViewData["PageIcon"] = "bi-person-plus";
}
<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <partial name="_PageHeader" />
            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>
        <section class="row g-3">
            <div class="col-12">
                <form asp-action="Create" method="post" class="panel">
                    <div class="p-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Select Cashiers</label>
                                    <select name="UserIds" class="form-select" multiple required size="5">
                                        @if (ViewBag.Cashiers != null)
                                        {
                                            foreach (var cashier in ViewBag.Cashiers)
                                            {
                                                <option value="@cashier.Id">
                                                    @cashier.UserName
                                                </option>
                                            }
                                        }
                                    </select>
                                    <small class="text-muted">Hold Ctrl to select multiple cashiers.</small>
                                </div>
                            <div class="col-md-6">
                                <label asp-for="ShiftName" class="form-label">Shift Name</label>
                                <input asp-for="ShiftName" class="form-control" placeholder="Enter shift name" />
                                <span asp-validation-for="ShiftName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label">Start Date</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label">End Date</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label">Start Time</label>
                                <input asp-for="StartTime" type="time" class="form-control" />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">End Time</label>
                                <input asp-for="EndTime" type="time" class="form-control" />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Shift
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}