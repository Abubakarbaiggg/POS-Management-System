@model IEnumerable<POS_Management_System.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Products</h4>
            <a asp-action="Create" class="btn btn-light btn-sm">+ Add New Product</a>
        </div>
        <div class="card-body">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Purchase Price</th>
                        <th>Sale Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" width="50" height="50" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="/images/no-image.png" width="50" height="50" style="object-fit: cover;" />
                                }
                            </td>
                            <td>@item.Name</td>
                            <td>@item.Category?.Name</td>
                            <td>@item.PurchasePrice.ToString("N2")</td>
                            <td>@item.SalePrice.ToString("N2")</td>
                            <td>
                                <span class="badge @(item.Quantity < 10 ? "bg-danger" : "bg-success")">
                                    @item.Quantity
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Stock" asp-route-id="@item.Id" class="btn btn-sm btn-info">Stock</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>