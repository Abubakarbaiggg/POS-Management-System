@model POS_Management_System.Models.Product

@{
    ViewData["Title"] = "Update Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Inventory</p>
                    <h1 class="h3 mb-1">Update Stock</h1>
                    <p class="text-muted mb-0">Manage product stock quantity safely and accurately.</p>
                </div>
            </div>
        </div>

        <section class="row g-3 justify-content-center">

            <!-- Form -->
            <div class="col-12 col-xl-6">

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-boxes"></i>
                                <span>@Model.Name</span>
                            </h2>
                            <p class="text-muted mb-0">Current stock: <strong>@Model.Quantity</strong> units</p>
                        </div>
                    </div>

                    <form asp-action="Stock" method="post" class="p-3">

                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Stock Quantity</label>
                            <input type="number"
                                   name="quantity"
                                   class="form-control form-control-lg"
                                   value="@Model.Quantity"
                                   min="0"
                                   required />
                            <small class="text-muted">Enter updated stock quantity</small>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2-circle"></i> Update Stock
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </section>

    </div>
</main>