@model POS_Management_System.Models.Product

@{
    ViewData["Title"] = "Update Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4>Update Stock - @Model.Name</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Stock" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label">Update Stock Quantity</label>
                            <input type="number" name="quantity" class="form-control" value="@Model.Quantity" required min="0" />
                        </div>
                        
                        <div class="mb-3">
                            <button type="submit" class="btn btn-info">Submit</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>