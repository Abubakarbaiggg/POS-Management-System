@model POS_Management_System.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Header -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-pencil-square text-warning"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Inventory</p>
                    <h1 class="h3 mb-1">Edit Product</h1>
                    <p class="text-muted mb-0">Update product details and pricing information.</p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM -->
            <div class="col-12 col-xl-8">

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data"
                      class="panel">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-box-seam"></i>
                                <span>Product Information</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Update product details carefully.
                            </p>
                        </div>
                    </div>

                    <div class="p-3">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImagePath" />

                        <!-- Category + Name -->
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label">Category</label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.Categories"
                                        class="form-select">

                                    <option value="">-- Select Category --</option>
                                </select>

                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Product Name</label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter product name" />

                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Prices -->
                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <label asp-for="PurchasePrice" class="form-label">Purchase Price</label>

                                <input asp-for="PurchasePrice"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SalePrice" class="form-label">Sale Price</label>

                                <input asp-for="SalePrice"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="SalePrice" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Stock + Image -->
                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <label class="form-label">Current Stock</label>

                                <input asp-for="Quantity"
                                       class="form-control"
                                       readonly />

                                <small class="text-muted">
                                    Stock can be updated from Stock menu.
                                </small>
                            </div>

                            <div class="col-md-6">

                                <label class="form-label">Current Image</label>

                                <div class="mb-2">
                                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                                    {
                                        <img src="@Model.ImagePath"
                                             width="90"
                                             height="90"
                                             style="object-fit:cover;border-radius:8px;" />
                                    }
                                </div>

                                <label asp-for="ImageFile" class="form-label">
                                    Change Image (Optional)
                                </label>

                                <input asp-for="ImageFile"
                                       type="file"
                                       accept="image/*"
                                       class="form-control" />

                            </div>

                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>

                    </div>

                </form>

            </div>

            <!-- SIDE PANEL -->
            <div class="col-12 col-xl-4">

                <div class="panel h-100">

                    <h2 class="h5 mb-3 section-title">
                        <i class="bi bi-info-circle"></i>
                        <span>Update Tips</span>
                    </h2>

                    <div class="activity-list">

                        <div class="activity-item">
                            <span class="activity-dot bg-warning"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Keep Prices Updated</p>
                                <p class="text-muted small mb-0">
                                    Ensure profit margins are correct.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-primary"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Check Stock</p>
                                <p class="text-muted small mb-0">
                                    Avoid negative inventory issues.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-success"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Use Clear Images</p>
                                <p class="text-muted small mb-0">
                                    Helps improve product visibility.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}