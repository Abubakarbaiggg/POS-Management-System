@model POS_Management_System.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Header -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-box-seam"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Inventory</p>
                    <h1 class="h3 mb-1">Create Product</h1>
                    <p class="text-muted mb-0">Add a new product to your inventory system.</p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM -->
            <div class="col-12 col-xl-8">

                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data"
                      class="panel">

                    <!-- Header -->
                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-plus-circle"></i>
                                <span>Product Information</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Fill in product details carefully.
                            </p>
                        </div>
                    </div>

                    <div class="p-3">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Category + Name -->
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label">Category</label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.Categories"
                                        class="form-select">

                                    <option value="">-- Select Category --</option>
                                </select>

                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Product Name</label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter product name" />

                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Prices -->
                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <label asp-for="PurchasePrice" class="form-label">Purchase Price</label>

                                <input asp-for="PurchasePrice"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SalePrice" class="form-label">Sale Price</label>

                                <input asp-for="SalePrice"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="SalePrice" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Stock + Image -->
                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label">Initial Stock</label>

                                <input asp-for="Quantity"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ImageFile" class="form-label">Product Image</label>

                                <input asp-for="ImageFile"
                                       type="file"
                                       accept="image/*"
                                       class="form-control" />

                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>

                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Product
                        </button>

                    </div>

                </form>

            </div>

            <!-- SIDE PANEL -->
            <div class="col-12 col-xl-4">

                <div class="panel h-100">

                    <h2 class="h5 mb-3 section-title">
                        <i class="bi bi-lightbulb"></i>
                        <span>Product Tips</span>
                    </h2>

                    <div class="activity-list">

                        <div class="activity-item">
                            <span class="activity-dot bg-primary"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Use Clear Names</p>
                                <p class="text-muted small mb-0">
                                    Example: iPhone 14, Nike Shoes
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-success"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Set Correct Prices</p>
                                <p class="text-muted small mb-0">
                                    Maintain proper profit margin.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-warning"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Upload Image</p>
                                <p class="text-muted small mb-0">
                                    Better images improve sales visibility.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}