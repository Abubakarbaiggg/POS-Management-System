@model POS_Management_System.Models.StockOut

@{
    ViewData["Title"] = "Delete Stock Out";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">Delete Stock Out</h4>
                        <small class="text-white-50">This action cannot be undone</small>
                    </div>

                    <a asp-action="Index" class="btn btn-light btn-sm">Cancel</a>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        Deleting this record will restore product stock quantities automatically.
                    </div>

                    <dl class="row mb-3">
                        <dt class="col-4">ID</dt>
                        <dd class="col-8 fw-semibold">#@Model.Id</dd>

                        <dt class="col-4">Date</dt>
                        <dd class="col-8">@Model.Date.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-4">Customer</dt>
                        <dd class="col-8">@Model.Customer?.Name</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">

                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-danger">
                                Delete Record
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>