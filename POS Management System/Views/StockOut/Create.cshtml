@model POS_Management_System.Models.ViewModels.StockOutViewModel

@{
    ViewData["Title"] = "New Stock Out";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-cart-dash"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Sales</p>
                    <h1 class="h3 mb-1">New Stock Out</h1>
                    <p class="text-muted mb-0">Create customer sale invoice and stock deduction.</p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    Back
                </a>
            </div>
        </div>

        <!-- Panel -->
        <section class="panel">

            <!-- Header -->
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-receipt"></i>
                        <span>Stock Out Form</span>
                    </h2>
                    <p class="text-muted mb-0">Fill customer and product sale details.</p>
                </div>
            </div>

            <form id="stockOutForm" asp-action="Create" method="post">
                <input type="hidden" id="productsJson" name="productsJson" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Products</h5>

                <div class="row g-2 mb-3">

                    <div class="col-md-4">
                        <select id="productSelect" class="form-select">
                            <option value="">-- Select Product --</option>
                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Id"
                                        data-price="@product.SalePrice"
                                        data-name="@product.Name">
                                    @product.Name - Stock: @product.Quantity
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <input type="number" id="quantity" class="form-control" placeholder="Qty" min="1" />
                    </div>

                    <div class="col-md-2">
                        <input type="number" id="price" class="form-control" placeholder="Price" step="0.01" />
                    </div>

                    <div class="col-md-2">
                        <button type="button" id="addProductBtn" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Add
                        </button>
                    </div>

                </div>

                <!-- Table -->
                <div class="table-responsive panel">

                    <table class="table align-middle mb-0" id="productsTable">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody id="productsTableBody"></tbody>

                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Grand Total:</th>
                                <th id="grandTotal" class="fw-bold text-success">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>

                        <div class="row mt-4">

                            <div class="col-md-4">
                                <label>Total Amount</label>
                                <input id="totalAmount"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-4">
                                <label>Paid Amount</label>
                                <input id="paidAmount"
                                       name="PaidAmount"
                                       class="form-control"
                                       type="number" />
                            </div>

                            <div class="col-md-4">
                                <label>Payment Method</label>

                                <select name="PaymentMethod"
                                        class="form-select">

                                    <option>Cash</option>
                                    <option>Card</option>
                                    <option>Bank Transfer</option>
                                    <option>JazzCash</option>
                                    <option>EasyPaisa</option>

                                </select>

                            </div>

                        </div>

                    </table>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Save Stock Out
                    </button>
                </div>

            </form>

        </section>
                       @section Scripts {
        <script>

                       

                                let products = [];

                                document.getElementById("addProductBtn").addEventListener("click", function () {

                                    let productSelect = document.getElementById("productSelect");
                                    let quantity = parseInt(document.getElementById("quantity").value);
                                    let price = parseFloat(document.getElementById("price").value);

                                    if (!productSelect.value) {
                                        alert("Please select a product");
                                        return;
                                    }

                                    if (!quantity || quantity <= 0) {
                                        alert("Please enter valid quantity");
                                        return;
                                    }

                                    if (!price || price <= 0) {
                                        alert("Please enter valid price");
                                        return;
                                    }

                                    let productId = parseInt(productSelect.value);
                                    let productName =
                                        productSelect.options[productSelect.selectedIndex].dataset.name;

                                    let total = quantity * price;

                                    let item = {
                                        productId: productId,
                                        productName: productName,
                                        quantity: quantity,
                                        unitPrice: price,
                                        total: total
                                    };

                                    products.push(item);

                                    renderTable();

                                    document.getElementById("quantity").value = "";
                                    document.getElementById("price").value = "";
                                    document.getElementById("productSelect").selectedIndex = 0;
                                });

                                function renderTable() {

                                    let tbody = document.getElementById("productsTableBody");
                                    tbody.innerHTML = "";

                                    let grandTotal = 0;

                                    products.forEach((item, index) => {

                                        grandTotal += item.total;

                                        tbody.innerHTML += `
                                            <tr>
                                                <td>${item.productName}</td>
                                                <td>${item.quantity}</td>
                                                <td>${item.unitPrice.toFixed(2)}</td>
                                                <td>${item.total.toFixed(2)}</td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            onclick="removeProduct(${index})">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        `;
                                    });

                                    document.getElementById("grandTotal").innerText =
                                        grandTotal.toFixed(2);
                                    document.getElementById("totalAmount").value =
                                    grandTotal.toFixed(2);

                                    document.getElementById("productsJson").value =
                                        JSON.stringify(products);
                                }

                                function removeProduct(index) {
                                    products.splice(index, 1);
                                    renderTable();  
                                }


        </script>
                }
    </div>
</main>