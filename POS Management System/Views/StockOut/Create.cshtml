@model POS_Management_System.Models.ViewModels.StockOutViewModel

@{
    ViewData["Title"] = "New Stock Out";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-cart-dash"></i></span>
                <div>
                    <p class="eyebrow mb-1">Sales</p>
                    <h1 class="h3 mb-1">New Stock Out</h1>
                    <p class="text-muted mb-0">Create customer sale invoice and stock deduction.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-receipt"></i>
                        <span>Stock Out Form</span>
                    </h2>
                    <p class="text-muted mb-0">Fill customer and product sale details.</p>
                </div>
            </div>

            <form id="stockOutForm" asp-action="Create" method="post">
                <input type="hidden" id="productsJson" name="productsJson" />
                <input type="hidden" id="totalAmountHidden" name="TotalAmount" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Products</h5>

                <p class="text-muted small">Click a product on the left to add it to the selection on the right. Quantity defaults to 1.</p>

                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <div id="categoryGroup" class="category-group">
                                <button type="button" class="btn category-btn active" data-id="0">All</button>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <button type="button" class="btn category-btn" data-id="@cat.Id">@cat.Name</button>
                                    }
                                }
                            </div>
                        </div>

                        <div id="leftProducts" class="row g-3">
                            @foreach (var product in ViewBag.Products)
                            {
                                var img = string.IsNullOrEmpty(product.ImagePath) ? "/images/no-image.png" : product.ImagePath;
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="card p-3 add-card product-card" style="cursor:pointer;" data-id="@product.Id" data-name="@product.Name" data-price="@product.SalePrice" data-image="@img" data-category="@product.CategoryId">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@img" alt="@product.Name" class="product-img" />
                                            <div class="product-info">
                                                <div class="fw-semibold product-title">@product.Name</div>
                                                <div class="text-muted small product-price">Price: @product.SalePrice.ToString("N2")</div>
                                                <div class="text-muted small product-stock">Stock: @product.Quantity</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="panel p-3">
                            <h6 class="mb-3">Selected Products</h6>

                            <div class="table-responsive">
                                <table class="table align-middle mb-0" id="selectedTable">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th style="width:90px">Qty</th>
                                            <th>Price</th>
                                            <th>Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="selectedBody"></tbody>
                                </table>
                            </div>

                            <div class="row mt-3 g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Total Amount</label>
                                    <input id="totalAmount" name="TotalAmount" class="form-control" readonly />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Paid Amount</label>
                                    <input id="paidAmount" name="PaidAmount" class="form-control" type="number" step="0.01" />
                                </div>

                                <div class="col-md-12 mt-2">
                                    <label class="form-label">Payment Method</label>
                                    <select name="PaymentMethod" class="form-select">
                                        <option>Cash</option>
                                        <option>Card</option>
                                        <option>Bank Transfer</option>
                                        <option>JazzCash</option>
                                        <option>EasyPaisa</option>
                                    </select>
                                </div>

                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Save Stock Out
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

            </form>

        </section>

    </div>
</main>

    <link rel="stylesheet" href="~/css/stockin.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/stockin.js" asp-append-version="true"></script>
}
    
