@model IEnumerable<POS_Management_System.Models.StockOut>

@{
    ViewData["Title"] = "Stock Outs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Stock Outs</h1>
                    <p class="text-muted mb-0">Manage product sales and stock out records.</p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle"></i> New Stock Out
                </a>
            </div>
        </div>

        <!-- Table Panel -->
        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-cart-check"></i>
                        <span>Stock Out List</span>
                    </h2>
                    <p class="text-muted mb-0">All sales transactions recorded in system.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Total Items</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">#@item.Id</td>

                                <td>
                                    @item.Date.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.Customer?.Name
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(item.StockOutDetails?.Sum(d => d.Quantity) ?? 0)
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </section>

    </div>
</main>