@model POS_Management_System.Models.ViewModels.AssignRoleViewModel

@{
    ViewData["Title"] = "Assign Role";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-person-gear"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">User Management</p>
                    <h1 class="h3 mb-1">Assign Role</h1>
                    <p class="text-muted mb-0">
                        Assign a role to the selected user.
                    </p>
                </div>
            </div>
        </div>

        <div class="panel">

            <div class="panel-header">
                <h2 class="h5">Role Assignment</h2>
            </div>

            <form asp-action="AssignRole" method="post">

                <input type="hidden" asp-for="UserId" />

                <div class="p-3">

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="UserName"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Role</label>

                        <select asp-for="SelectedRole"
                                asp-items="Model.Roles"
                                class="form-select">

                            <option value="">Select Role</option>

                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 p-3 border-top">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Assign Role

                    </button>

                </div>

            </form>

        </div>

    </div>
</main>