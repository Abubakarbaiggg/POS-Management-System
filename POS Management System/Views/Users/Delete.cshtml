@model POS_Management_System.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-person-x"></i></span>
                <div>
                    <p class="eyebrow mb-1">User Management</p>
                    <h1 class="h3 mb-1">Delete User</h1>
                    <p class="text-muted mb-0">This action will permanently remove the user account.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Warning: Irreversible Action</span>
                    </h2>
                    <p class="text-muted mb-0">Please confirm before deleting this user.</p>
                </div>
            </div>

            <div class="panel">

                <dl class="row mb-0">

                    <dt class="col-4">Username</dt>
                    <dd class="col-8">@Model.UserName</dd>

                    <dt class="col-4">Email</dt>
                    <dd class="col-8">@Model.Email</dd>

                </dl>

            </div>

            <form asp-action="Delete" method="post" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete User
                    </button>

                </div>

            </form>

        </section>

    </div>
</main>