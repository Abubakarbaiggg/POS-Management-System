@model POS_Management_System.Models.ViewModels.UserPermissionsViewModel

@{
    ViewData["Title"] = "Manage Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Manage Permissions</h4>
                <small>User: @Model.UserName</small>
            </div>

            <a asp-action="Index" class="btn btn-light btn-sm">Back</a>
        </div>

        <div class="card-body">

            <form asp-action="UpdatePermissions" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Permission</th>
                                <th width="120">Granted</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Permissions.Count; i++)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @Model.Permissions[i].Name
                                    </td>

                                    <td>
                                        <input type="hidden" name="Permissions[@i].Name" value="@Model.Permissions[i].Name" />

                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="Permissions[@i].Selected"
                                                   value="true"
                                            @(Model.Permissions[i].Selected ? "checked" : "") />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        Save Permissions
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>