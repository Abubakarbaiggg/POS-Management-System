@model IEnumerable<POS_Management_System.Models.StockOut>

@{
    ViewData["Title"] = "Stock Out Report";
}

<main class="dashboard-content">

    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">

            <div class="page-heading-copy">

                <span class="page-icon">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </span>

                <div>

                    <p class="eyebrow mb-1">
                        Reports
                    </p>

                    <h2 class="mb-1">
                        Stock Out Report
                    </h2>

                    <p class="text-muted">
                        View all sales invoices and stock out transactions.
                    </p>

                </div>

            </div>

            <div>

                <a asp-action="Download"
                   asp-route-fromDate="@ViewBag.FromDate"
                   asp-route-toDate="@ViewBag.ToDate"
                   asp-route-customerId="@ViewBag.CustomerId"
                   asp-route-search="@ViewBag.Search"
                   class="btn btn-success">

                    <i class="bi bi-download"></i>

                    Export Excel

                </a>

            </div>

        </div>

        <!-- Summary Cards -->

        <div class="row mt-4">

            <div class="col-lg-3 col-md-6 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Invoices
                        </small>

                        <h3 class="fw-bold mt-2">
                            @ViewBag.TotalInvoices
                        </h3>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Sales
                        </small>

                        <h3 class="text-primary fw-bold mt-2">

                            Rs.
                            @(((decimal)ViewBag.TotalSales).ToString("N2"))

                        </h3>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Paid
                        </small>

                        <h3 class="text-success fw-bold mt-2">

                            Rs.
                            @(((decimal)ViewBag.TotalPaid).ToString("N2"))

                        </h3>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <small class="text-muted">
                            Remaining
                        </small>

                        <h3 class="text-danger fw-bold mt-2">

                            Rs.
                            @(((decimal)ViewBag.TotalRemaining).ToString("N2"))

                        </h3>

                    </div>

                </div>

            </div>

        </div>

        <!-- Filter -->

        <section class="panel mt-4">

            <div class="panel-header">

                <h5 class="mb-0">

                    <i class="bi bi-funnel"></i>

                    Filter Report

                </h5>

            </div>

            <div class="p-3">

                <form method="get">

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label class="form-label">
                                From Date
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="fromDate"
                                   value="@ViewBag.FromDate" />

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                To Date
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="toDate"
                                   value="@ViewBag.ToDate" />

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Customer
                            </label>

                            <select class="form-select"
                                    asp-items="ViewBag.Customers"
                                    name="customerId">

                                <option value="">
                                    All Customers
                                </option>

                            </select>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Search
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Customer / Product"
                                   name="search"
                                   value="@ViewBag.Search" />

                        </div>

                        <div class="col-12">

                            <button class="btn btn-primary">

                                <i class="bi bi-search"></i>

                                Search

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Reset

                            </a>

                        </div>

                    </div>

                </form>

            </div>

        </section>

        <!-- Table -->

        <section class="panel mt-4">

            <div class="panel-header">

                <h5 class="mb-0">

                    <i class="bi bi-table"></i>

                    Stock Out Transactions

                </h5>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Products</th>

                            <th>Total</th>

                            <th>Paid</th>

                            <th>Remaining</th>

                            <th>Payment</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@sr</td>

                                    <td>
                                        @item.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(item.Customer?.Name ?? "Walk In Customer")
                                    </td>

                                    <td>

                                        <ul class="mb-0 ps-3">
                                            @foreach (var detail in item.StockOutDetails!)
                                            {
                                                <li>
                                                    <strong>@detail.Product?.Name</strong>
                                                    <span class="badge bg-primary ms-2">
                                                        Qty : @detail.Quantity
                                                    </span>

                                                    <span class="text-muted">
                                                        (Rs. @detail.UnitPrice.ToString("N2"))
                                                    </span>
                                                </li>
                                            }

                                        </ul>

                                    </td>

                                    <td>

                                        Rs.
                                        @((item.CustomerPayment?.TotalAmount ?? 0).ToString("N2"))

                                    </td>

                                    <td>

                                        Rs.
                                        @((item.CustomerPayment?.PaidAmount ?? 0).ToString("N2"))

                                    </td>

                                    <td>

                                        Rs.
                                        @((item.CustomerPayment?.RemainingAmount ?? 0).ToString("N2"))

                                    </td>

                                    <td>

                                        <span class="badge bg-info">

                                            @item.CustomerPayment?.PaymentMethod

                                        </span>

                                    </td>

                                    <td>

                                        @if ((item.CustomerPayment?.RemainingAmount ?? 0) == 0)
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if ((item.CustomerPayment?.PaidAmount ?? 0) == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Unpaid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Partial
                                            </span>
                                        }

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9" class="text-center py-5">

                                    <i class="bi bi-inbox fs-1 text-muted"></i>

                                    <h5 class="mt-3">

                                        No Stock Out Record Found

                                    </h5>

                                    <p class="text-muted">

                                        Try changing your filters.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4" class="text-end">

                                Grand Total

                            </th>

                            <th>

                                Rs.
                                @(((decimal)ViewBag.TotalSales).ToString("N2"))

                            </th>

                            <th>

                                Rs.
                                @(((decimal)ViewBag.TotalPaid).ToString("N2"))

                            </th>

                            <th>

                                Rs.
                                @(((decimal)ViewBag.TotalRemaining).ToString("N2"))

                            </th>

                            <th></th>

                            <th></th>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </section>

    </div>

</main>