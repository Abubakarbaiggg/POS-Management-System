@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Roles";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- HEADER -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-shield-lock"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Security</p>
                    <h1 class="h3 mb-1">Roles</h1>
                    <p class="text-muted mb-0">Manage system roles and permissions.</p>
                </div>
            </div>

            <div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Role
                </a>
            </div>
        </div>

        <!-- TOASTS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["Error"]</div>
        }

        <!-- TABLE -->
        <section class="panel mt-4">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-list"></i> Roles List
                    </h2>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@role.Name</td>

                                <td class="text-end">

                                    <a asp-action="ManagePermissions"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-primary">
                                        Permissions
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </section>

    </div>
</main>