@{
    ViewData["Title"] = "Create Role";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- PAGE HEADER -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">User Management</p>
                    <h1 class="h3 mb-1">Create Role</h1>
                    <p class="text-muted mb-0">
                        Add a new system role for user access management.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM SECTION -->
            <div class="col-12">

                <form asp-action="Create" method="post" class="panel needs-validation">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-person-plus"></i>
                                <span>Role Details</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Define a role name for user authorization.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <!-- Role Name -->
                        <div class="col-12">
                            <label class="form-label">Role Name</label>

                            <input name="name"
                                   class="form-control"
                                   placeholder="Enter role name" />
                        </div>

                    </div>

                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Role
                        </button>

                    </div>

                </form>

            </div>
        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}