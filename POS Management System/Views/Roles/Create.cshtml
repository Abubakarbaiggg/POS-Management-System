@{
    ViewData["Title"] = "Create Role";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div>
                <h1 class="h3">Create Role</h1>
                <p class="text-muted">Add a new system role.</p>
            </div>
        </div>

        <form asp-action="Create" method="post" class="panel">

            <div class="panel-header">
                <h2 class="h5">Role Information</h2>
            </div>

            <div class="p-3">

                <label class="form-label">Role Name</label>
                <input name="name" class="form-control" placeholder="Enter role name" />

            </div>

            <div class="d-flex justify-content-end gap-2 p-3 border-top">

                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

                <button type="submit" class="btn btn-primary">
                    Create Role
                </button>

            </div>

        </form>

    </div>
</main>