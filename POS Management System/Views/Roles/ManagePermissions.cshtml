@model POS_Management_System.Models.ViewModels.RolePermissionsViewModel

@{
    ViewData["Title"] = "Manage Role Permissions";
}

<h2>Manage Permissions for @Model.RoleName</h2>

<form asp-action="UpdateRolePermissions" method="post" asp-antiforgery="true">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId" />

    <table class="table">
        <thead>
            <tr>
                <th>Permission</th>
                <th>Assigned</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Permissions)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>
                        <input type="checkbox" name="selectedPermissionIds" value="@p.Id" @(p.Selected ? "checked" : "") />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
