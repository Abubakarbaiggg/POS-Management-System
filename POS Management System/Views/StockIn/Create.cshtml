@model POS_Management_System.Models.ViewModels.StockInViewModel

@{
    ViewData["Title"] = "New Stock In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-cart-plus"></i></span>
                <div>
                    <p class="eyebrow mb-1">Purchase</p>
                    <h1 class="h3 mb-1">New Stock In</h1>
                    <p class="text-muted mb-0">Add supplier purchase and stock entry details.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-box-seam"></i>
                        <span>Stock Entry Form</span>
                    </h2>
                    <p class="text-muted mb-0">Fill supplier and product details below.</p>
                </div>
            </div>

            <form id="stockInForm" asp-action="Create" method="post">
                <input type="hidden" id="productsJson" name="productsJson" />
                <input type="hidden" id="totalAmountHidden" name="TotalAmount" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Supplier</label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Products</h5>

                <p class="text-muted small">Click a product on the left to add it to the selection on the right. Quantity defaults to 1.</p>

                <div class="row">
                    <!-- Left: Category filter + Product Cards (rendered server-side) -->
                    <div class="col-md-7">
                        <div class="mb-3">
                            <div id="categoryGroup" class="category-group">
                                <button type="button" class="btn category-btn active" data-id="0">All</button>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <button type="button" class="btn category-btn" data-id="@cat.Id">@cat.Name</button>
                                    }
                                }
                            </div>
                        </div>

                        <div id="leftProducts" class="row g-3">
                            @foreach (var product in ViewBag.Products)
                            {
                                var img = string.IsNullOrEmpty(product.ImagePath) ? "/images/no-image.png" : product.ImagePath;
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="card p-3 add-card product-card" style="cursor:pointer;" data-id="@product.Id" data-name="@product.Name" data-price="@product.PurchasePrice" data-image="@img" data-category="@product.CategoryId">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@img" alt="@product.Name" class="product-img" />
                                            <div class="product-info">
                                                <div class="fw-semibold product-title">@product.Name</div>
                                                <div class="text-muted small product-price">Price: @product.PurchasePrice.ToString("N2")</div>
                                                <div class="text-muted small product-stock">Stock: @product.Quantity</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Right: Selected list, quantity controls, totals -->
                    <div class="col-md-5">
                        <div class="panel p-3">
                            <h6 class="mb-3">Selected Products</h6>

                            <div class="table-responsive">
                                <table class="table align-middle mb-0" id="selectedTable">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th style="width:90px">Qty</th>
                                            <th>Price</th>
                                            <th>Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="selectedBody"></tbody>
                                </table>
                            </div>

                            <div class="row mt-3 g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Total Amount</label>
                                    <input id="totalAmount" name="TotalAmount" class="form-control" readonly />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Paid Amount</label>
                                    <input id="paidAmount" name="PaidAmount" class="form-control" type="number" step="0.01" />
                                </div>

                                <div class="col-md-12 mt-2">
                                    <label class="form-label">Payment Method</label>
                                    <select name="PaymentMethod" class="form-select">
                                        <option>Cash</option>
                                        <option>Card</option>
                                        <option>Bank Transfer</option>
                                        <option>JazzCash</option>
                                        <option>EasyPaisa</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Save Stock In
                    </button>
                </div>

            </form>

        </section>
    </div>
    <style>
        /* Category group - horizontal scrollable pills */
        .category-group { display:flex; gap:8px; overflow-x:auto; padding:6px 4px; }
        .category-group::-webkit-scrollbar { height:6px; }
        .category-group .btn { white-space:nowrap; border-radius:8px; border:1px solid #cfe2ff; padding:6px 12px; background:#fff; color:#0d6efd; }
        .category-btn.active { background-color:#0d6efd; color:#fff; box-shadow:0 6px 18px rgba(13,110,253,0.08); }

        /* Product cards */
        .product-card { transition: box-shadow .12s, transform .08s, border-color .08s; border-radius:10px; border:1px solid #eef3fb; background:#fff; }
        .product-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(2,6,23,0.06); }
        .product-card.selected-card { border:2px solid #0d6efd; background-color:#e9f6ff; }
        .product-img { width:56px; height:56px; object-fit:cover; border-radius:8px; }
        .product-info { min-height:56px; }
        .product-title { font-size:0.95rem; }
        .product-price, .product-stock { margin-top:4px; }

        /* Right panel */
        .panel.p-3 { border-radius:10px; box-shadow:0 8px 28px rgba(2,6,23,0.04); background:#fff; }
        #selectedTable tbody tr td { vertical-align: middle; }
        #selectedBody { max-height: 420px; overflow:auto; display:block; }
        #selectedTable { width:100%; }
        #selectedTable tbody { display:block; }
        #selectedTable thead, #selectedTable tbody tr { display:table; width:100%; table-layout:fixed; }
        #selectedTable thead { width:100%; }
        .qty-input { max-width:90px; }

        /* responsive spacing */
        &#64;media (max-width:767px) {
        .category-group { gap:6px; }
        #selectedBody { max-height:200px; }
        }
        </style>
    <link rel="stylesheet" href="~/css/stockin.css" asp-append-version="true" />

    @section Scripts {
        <script src="~/js/stockin.js" asp-append-version="true"></script>
    }

</main>
