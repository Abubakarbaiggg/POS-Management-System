@model POS_Management_System.Models.ViewModels.StockInViewModel

@{
    ViewData["Title"] = "New Stock In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-cart-plus"></i></span>
                <div>
                    <p class="eyebrow mb-1">Purchase</p>
                    <h1 class="h3 mb-1">New Stock In</h1>
                    <p class="text-muted mb-0">Add supplier purchase and stock entry details.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-box-seam"></i>
                        <span>Stock Entry Form</span>
                    </h2>
                    <p class="text-muted mb-0">Fill supplier and product details below.</p>
                </div>
            </div>

            <form id="stockInForm" asp-action="Create" method="post">
                <input type="hidden" id="productsJson" name="productsJson" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Supplier</label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Products</h5>

                <div class="row g-2 mb-3">

                    <div class="col-md-4">
                        <select id="productSelect" class="form-select">
                            <option value="">-- Select Product --</option>
                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Id"
                                        data-price="@product.PurchasePrice"
                                        data-name="@product.Name">
                                    @product.Name - Stock: @product.Quantity
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <input type="number" id="quantity" class="form-control" placeholder="Qty" min="1" />
                    </div>

                    <div class="col-md-2">
                        <input type="number" id="price" class="form-control" placeholder="Price" step="0.01" />
                    </div>

                    <div class="col-md-2">
                        <button type="button" id="addProductBtn" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Add
                        </button>
                    </div>

                </div>

                <div class="table-responsive panel">

                    <table class="table align-middle mb-0" id="productsTable">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Total</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody id="productsTableBody"></tbody>

                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Grand Total:</th>
                                <th id="grandTotal">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>

                        <div class="row mt-4">

                            <div class="col-md-4">
                                <label>Total Amount</label>
                                <input id="totalAmount"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-4">
                                <label>Paid Amount</label>
                                <input id="paidAmount"
                                       name="PaidAmount"
                                       class="form-control"
                                       type="number" />
                            </div>

                            <div class="col-md-4">
                                <label>Payment Method</label>

                                <select name="PaymentMethod"
                                        class="form-select">

                                    <option>Cash</option>
                                    <option>Card</option>
                                    <option>Bank Transfer</option>
                                    <option>JazzCash</option>
                                    <option>EasyPaisa</option>

                                </select>

                            </div>

                        </div>

    



                    </table>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Save Stock In
                    </button>
                </div>

            </form>

        </section>
    </div>
                @section Scripts {
                <script>
                        let products = [];

                        document.getElementById("addProductBtn").addEventListener("click", function () {

                            let productSelect = document.getElementById("productSelect");
                            let quantity = parseInt(document.getElementById("quantity").value);
                            let price = parseFloat(document.getElementById("price").value);

                            if (!productSelect.value) {
                                alert("Please select a product");
                                return;
                            }

                            if (!quantity || quantity <= 0) {
                                alert("Enter valid quantity");
                                return;
                            }

                            if (!price || price <= 0) {
                                alert("Enter valid price");
                                return;
                            }

                            let productId = parseInt(productSelect.value);
                            let productName =
                                productSelect.options[productSelect.selectedIndex].dataset.name;

                            let total = quantity * price;

                            let item = {
                                productId: productId,
                                productName: productName,
                                quantity: quantity,
                                purchasePrice: price,
                                total: total
                            };

                            products.push(item);

                            renderTable();

                            document.getElementById("productsJson").value =
                                JSON.stringify(products);

                            document.getElementById("quantity").value = "";
                            document.getElementById("price").value = "";
                            document.getElementById("productSelect").selectedIndex = 0;
                        });

                        function renderTable() {

                            let tbody = document.getElementById("productsTableBody");
                            tbody.innerHTML = "";

                            let grandTotal = 0;

                            products.forEach((item, index) => {

                                grandTotal += item.total;

                                tbody.innerHTML += `
                                    <tr>
                                        <td>${item.productName}</td>
                                        <td>${item.quantity}</td>
                                        <td>${item.purchasePrice.toFixed(2)}</td>
                                        <td>${item.total.toFixed(2)}</td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="removeProduct(${index})">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                `;
                            });

                            document.getElementById("grandTotal").innerText =
                                grandTotal.toFixed(2);
                    document.getElementById("totalAmount").value =
                                                    grandTotal.toFixed(2);

                            document.getElementById("productsJson").value =
                                JSON.stringify(products);
                        }

                        function removeProduct(index) {
                            products.splice(index, 1);
                            renderTable();
                        }
            </script>
        }
</main>