@model POS_Management_System.Models.StockIn

@{
    ViewData["Title"] = "Stock In Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Inventory</p>
                    <h1 class="h3 mb-1">Stock In Details</h1>
                    <p class="text-muted mb-0">Complete purchase transaction information.</p>
                </div>
            </div>
        </div>

        <section class="row g-3">

            <!-- Supplier Info -->
            <div class="col-12 col-xl-4">

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-truck"></i>
                                <span>Supplier Info</span>
                            </h2>
                            <p class="text-muted mb-0">Purchase source details</p>
                        </div>
                    </div>

                    <div class="p-3">

                        <dl class="row mb-0">

                            <dt class="col-5">Stock ID</dt>
                            <dd class="col-7">#@Model.Id</dd>

                            <dt class="col-5">Date</dt>
                            <dd class="col-7">@Model.Date.ToString("yyyy-MM-dd")</dd>

                            <dt class="col-5">Supplier</dt>
                            <dd class="col-7">@Model.Supplier?.Name</dd>

                            <dt class="col-5">Phone</dt>
                            <dd class="col-7">@Model.Supplier?.Phone</dd>

                        </dl>

                    </div>

                </div>

            </div>

            <!-- Product Table -->
            <div class="col-12 col-xl-8">

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-box-seam"></i>
                                <span>Purchased Products</span>
                            </h2>
                            <p class="text-muted mb-0">All items included in this stock entry</p>
                        </div>
                    </div>

                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.StockInDetails!)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @item.Quantity
                                            </span>
                                        </td>
                                        <td>@item.PurchasePrice.ToString("N2")</td>
                                        <td class="fw-semibold">@item.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Grand Total:</th>
                                    <th>
                                        @Model.StockInDetails?.Sum(d => d.Total).ToString("N2")
                                    </th>
                                </tr>
                            </tfoot>

                        </table>

                    </div>

                </div>

            </div>

        </section>

        <!-- Back Button -->
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

    </div>
</main>