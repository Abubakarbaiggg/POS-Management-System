@model POS_Management_System.Models.StockIn

@{
    ViewData["Title"] = "Delete Stock In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-trash3" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Stock Management</p>
                    <h1 class="h3 mb-1">Delete Stock In</h1>
                    <p class="text-muted mb-0">This action will permanently remove stock purchase record.</p>
                </div>
            </div>
        </div>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                        <span>Confirm Deletion</span>
                    </h2>
                    <p class="text-muted mb-0">Please review details before deleting.</p>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-12 col-lg-5">
                    <div class="panel h-100">
                        <h5 class="mb-3">Stock Information</h5>

                        <dl class="row mb-0">
                            <dt class="col-5">ID</dt>
                            <dd class="col-7">@Model.Id</dd>

                            <dt class="col-5">Date</dt>
                            <dd class="col-7">@Model.Date.ToString("yyyy-MM-dd")</dd>

                            <dt class="col-5">Supplier</dt>
                            <dd class="col-7">@Model.Supplier?.Name</dd>
                        </dl>
                    </div>
                </div>

                <div class="col-12 col-lg-7">
                    <div class="panel">
                        <h5 class="mb-3">Products</h5>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.StockInDetails!)
                                    {
                                        <tr>
                                            <td>@item.Product?.Name</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3 text-end">
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>

            </div>
        </section>

    </div>
</main>