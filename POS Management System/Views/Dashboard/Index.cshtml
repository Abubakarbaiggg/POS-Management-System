@model POS_Management_System.ViewModels.DashboardViewModel

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-speedometer2"></i></span>
                <div>
                    <h1 class="h3">Dashboard</h1>
                    <p class="text-muted">Business overview & stock analytics</p>
                </div>
            </div>
        </div>

        <!-- ROW 1 -->
        <section class="row g-3">

            <div class="col-xl-3 col-md-6">
                <div class="metric-card metric-primary">
                    <div>Today Sales</div>
                    <h3>Rs @Model.TodaySales.ToString("N0")</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card metric-success">
                    <div>Monthly Sales</div>
                    <h3>Rs @Model.MonthlySales.ToString("N0")</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card metric-warning">
                    <div>Total Products</div>
                    <h3>@Model.ProductsCount</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card metric-danger">
                    <div>Low Stock</div>
                    <h3>@Model.LowStockCount</h3>
                </div>
            </div>

        </section>

        <!-- ROW 2 -->
        <section class="row g-3 mt-2">

            <div class="col-xl-3 col-md-6">
                <div class="metric-card">
                    <div>Stock In (Month)</div>
                    <h3>Rs @Model.MonthlyStockIn.ToString("N0")</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card">
                    <div>Customers</div>
                    <h3>@Model.CustomersCount</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card">
                    <div>Suppliers</div>
                    <h3>@Model.SuppliersCount</h3>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="metric-card">
                    <div>Stock Movement</div>
                    <small>In vs Out</small>
                    <div>
                        <b>IN:</b> @Model.TotalStockIn.ToString("N0") <br />
                        <b>OUT:</b> @Model.TotalStockOut.ToString("N0")
                    </div>
                </div>
            </div>

        </section>

    </div>
</main>