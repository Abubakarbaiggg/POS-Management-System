@model POS_Management_System.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Header -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-folder-plus" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Inventory Management</p>
                    <h1 class="h3 mb-1">Create Category</h1>
                    <p class="text-muted mb-0">
                        Add a new category to organize your products.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3">

            <!-- FORM SECTION -->
            <div class="col-12 col-xl-8">

                <form asp-action="Create" method="post" class="panel">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title">
                                <i class="bi bi-folder-plus"></i>
                                <span>Category Information</span>
                            </h2>
                            <p class="text-muted mb-0">
                                Enter category details below.
                            </p>
                        </div>
                    </div>

                    <div class="p-3">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Category Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Category Name</label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter category name" />

                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Category
                        </button>

                    </div>

                </form>

            </div>

            <!-- SIDE PANEL -->
            <div class="col-12 col-xl-4">

                <div class="panel h-100">

                    <h2 class="h5 mb-3 section-title">
                        <i class="bi bi-lightbulb"></i>
                        <span>Tips</span>
                    </h2>

                    <div class="activity-list">

                        <div class="activity-item">
                            <span class="activity-dot bg-success"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Use Clear Names</p>
                                <p class="text-muted small mb-0">
                                    Example: Electronics, Clothing, Grocery.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-primary"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Avoid Duplicates</p>
                                <p class="text-muted small mb-0">
                                    Keep category names unique.
                                </p>
                            </div>
                        </div>

                        <div class="activity-item">
                            <span class="activity-dot bg-warning"></span>
                            <div>
                                <p class="mb-1 fw-semibold">Organization</p>
                                <p class="text-muted small mb-0">
                                    Helps in better product management.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}