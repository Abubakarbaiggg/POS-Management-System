@model POS_Management_System.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Header -->
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-trash text-danger" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Danger Zone</p>
                    <h1 class="h3 mb-1 text-danger">Delete Category</h1>
                    <p class="text-muted mb-0">
                        This action cannot be undone.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <section class="row g-3 justify-content-center">

            <!-- Delete Card -->
            <div class="col-12 col-xl-6">

                <div class="panel border-danger">

                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title text-danger">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span>Confirm Delete</span>
                            </h2>

                            <p class="text-muted mb-0">
                                Please review category details before deleting.
                            </p>
                        </div>
                    </div>

                    <div class="p-3">

                        <div class="alert alert-warning d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle"></i>
                            <span>
                                Deleting this category may affect related products.
                            </span>
                        </div>

                        <dl class="row mb-0">

                            <dt class="col-sm-4 text-muted">ID</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.Id</dd>

                            <dt class="col-sm-4 text-muted">Name</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                        </dl>

                    </div>

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-end gap-2 p-3 border-top">

                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete Category
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </section>

    </div>
</main>